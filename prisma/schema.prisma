// Prisma schema for JuraganWebsite CMS - WordPress-class
// PT Digital Bisnis Manajemen (Digiman) - since 2007

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  name        String
  email       String   @unique
  role        String   @default("admin")
  avatar      String?
  bio         String?
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleId       String
  titleEn       String
  excerptId     String
  excerptEn     String
  contentId     String
  contentEn     String
  category      String   @default("Umum")
  tags          String   @default("")
  coverImage    String?
  author        String   @default("Tim JuraganWebsite")
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  views         Int      @default(0)
  // SEO fields
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  ogImage         String?
  // Status: published, draft, pending, trash
  status      String   @default("published")
  pinned      Boolean  @default(false)
  allowComments Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status])
  @@index([category])
}

model Page {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleId       String
  titleEn       String
  contentId     String
  contentEn     String
  excerptId     String   @default("")
  excerptEn     String   @default("")
  coverImage    String?
  template      String   @default("default")
  // status: published, draft, trash
  status        String   @default("published")
  showInMenu    Boolean  @default(true)
  menuOrder     Int      @default(0)
  parentId      String?
  metaTitle       String?
  metaDescription String?
  author        String   @default("Tim JuraganWebsite")
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Portfolio {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleId     String
  titleEn     String
  descId      String
  descEn      String
  category    String   @default("Website")
  client      String
  url         String?
  image       String?
  gallery     String   @default("[]")  // JSON array of image URLs
  year        Int      @default(2024)
  featured    Boolean  @default(false)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id         String   @id @default(cuid())
  slug       String   @unique
  titleId    String
  titleEn    String
  descId     String
  descEn     String
  icon       String   @default("Code")
  price      Int      @default(0)
  priceLabel String   @default("")
  features   String   @default("")
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String
  role      String
  messageId String
  messageEn String
  rating    Int      @default(5)
  avatar    String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  name      String
  email     String
  website   String?
  content   String
  // status: approved, pending, spam, trash
  status    String   @default("pending")
  parentId  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([postId])
  @@index([status])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  thumbUrl  String?
  mimeType  String
  size      Int      @default(0)
  width     Int?
  height    Int?
  alt       String   @default("")
  caption   String   @default("")
  uploadedBy String @default("admin")
  folder    String   @default("/")
  createdAt DateTime @default(now())
  @@index([folder])
}

model Menu {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  location  String   @default("header")
  items     String   @default("[]")  // JSON array of menu items
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueId   String
  valueEn   String
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  source    String   @default("website")
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  action    String   // created, updated, deleted, login, logout, published
  entity    String   // post, page, portfolio, service, testimonial, message, comment, media, menu, setting, user
  entityId  String?
  entityTitle String?
  details   String   @default("")
  ip        String?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameId      String
  nameEn      String
  description String   @default("")
  parentId    String?
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  slug       String   @unique
  name       String
  count      Int      @default(0)
  createdAt  DateTime @default(now())
}

// =====================================================
// HOSTING PANEL — melebihi IDCloudHost + Hostinger
// =====================================================

model ServicePackage {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameId      String
  nameEn      String
  descId      String   @default("")
  descEn      String   @default("")
  category    String   @default("hosting")  // hosting, vps, cloud, domain, ssl, email, wordpress
  price       Int      @default(0)          // per month, IDR
  priceYearly Int      @default(0)
  setupFee    Int      @default(0)
  currency    String   @default("IDR")
  billingCycle String @default("monthly")  // monthly, yearly, one-time
  features    String   @default("[]")      // JSON array
  specs       String   @default("{}")      // JSON: cpu, ram, disk, bandwidth, databases, emails, ssl
  popular     Boolean  @default(false)
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  order       Int      @default(0)
  maxOrders   Int      @default(0)         // 0 = unlimited
  stock       Int      @default(0)         // -1 = unlimited
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category])
  @@index([active])
}

model Customer {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  phone       String?
  company     String?
  address     String?
  city        String?
  country     String   @default("Indonesia")
  password    String
  status      String   @default("active")  // active, suspended, banned
  avatar      String?
  verified    Boolean  @default(false)
  totalSpent  Int      @default(0)
  totalOrders Int      @default(0)
  notes       String   @default("")
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status])
}

model Order {
  id            String   @id @default(cuid())
  invoice       String   @unique  // INV-2025-0001
  customerId    String
  customerName  String
  customerEmail String
  // JSON array of { packageId, name, price, qty, period, domain }
  items         String   @default("[]")
  subtotal      Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  total         Int      @default(0)
  couponCode    String?
  paymentMethod String?  // bank, qris, paypal, crypto
  paymentStatus String   @default("pending")  // pending, paid, failed, refunded
  status        String   @default("pending")   // pending, processing, completed, cancelled
  notes         String   @default("")
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
}

model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique  // INV-2025-0001
  orderId       String?
  customerId    String
  customerName  String
  customerEmail String
  items         String   @default("[]")  // JSON
  subtotal      Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  total         Int      @default(0)
  currency      String   @default("IDR")
  status        String   @default("unpaid")  // unpaid, paid, overdue, cancelled
  dueDate       DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([customerId])
  @@index([status])
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String?
  orderId       String?
  customerId    String
  amount        Int      @default(0)
  currency      String   @default("IDR")
  method        String   // bank_transfer, qris, credit_card, paypal, crypto
  gateway       String?  // midtrans, xendit, manual
  gatewayRef    String?
  status        String   @default("pending")  // pending, success, failed, refunded
  fee           Int      @default(0)
  notes         String   @default("")
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  @@index([customerId])
  @@index([status])
}

model Ticket {
  id          String   @id @default(cuid())
  number      String   @unique  // TKT-2025-0001
  customerId   String?
  customerName String
  customerEmail String
  subject     String
  category    String   @default("general")  // general, billing, technical, sales, abuse
  priority    String   @default("normal")   // low, normal, high, urgent
  status      String   @default("open")     // open, pending, resolved, closed
  department  String   @default("support") // support, billing, sales, technical
  assignedTo  String?
  message     String
  tags        String   @default("")
  rating      Int      @default(0)
  firstResponseAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  author    String
  authorRole String  @default("customer")  // customer, admin, staff
  message   String
  attachments String @default("[]")  // JSON
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([ticketId])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleId   String
  titleEn   String
  contentId String
  contentEn String
  excerptId String   @default("")
  excerptEn String   @default("")
  category  String   @default("general")
  tags      String   @default("")
  views     Int      @default(0)
  helpful   Int      @default(0)
  unhelpful Int      @default(0)
  published Boolean  @default(true)
  featured  Boolean  @default(false)
  author    String   @default("Tim JuraganWebsite")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category])
  @@index([published])
}

model KnowledgeCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameId    String
  nameEn    String
  descId    String   @default("")
  descEn    String   @default("")
  icon      String   @default("HelpCircle")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Affiliate {
  id          String   @id @default(cuid())
  customerId  String?
  code        String   @unique  // referral code
  name        String
  email       String
  commissionRate Float @default(10)  // percent
  totalClicks Int      @default(0)
  totalSignups Int     @default(0)
  totalSales  Int      @default(0)
  totalCommission Float @default(0)
  paidOut     Float    @default(0)
  balance     Float    @default(0)
  status      String   @default("active")  // active, suspended, banned
  createdAt   DateTime @default(now())
  @@index([status])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  code        String
  ip          String?
  userAgent    String?
  referer      String?
  converted    Boolean  @default(false)
  convertedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([affiliateId])
}

model ServerMetric {
  id          String   @id @default(cuid())
  server      String   @default("main")  // server identifier
  cpuUsage    Float    @default(0)       // percent
  ramUsage    Float    @default(0)       // percent
  diskUsage   Float    @default(0)       // percent
  bandwidthIn Int      @default(0)       // bytes
  bandwidthOut Int     @default(0)
  uptime      Int      @default(0)       // seconds
  loadAvg     String   @default("0,0,0")
  processes   Int      @default(0)
  connections Int      @default(0)
  createdAt   DateTime @default(now())
  @@index([server])
  @@index([createdAt])
}

model CronJob {
  id          String   @id @default(cuid())
  name        String
  command     String
  schedule    String   // cron format: */5 * * * *
  description String   @default("")
  enabled     Boolean  @default(true)
  lastRun     DateTime?
  nextRun     DateTime?
  lastStatus  String?  // success, failed
  lastOutput  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DNSRecord {
  id          String   @id @default(cuid())
  domain      String
  type        String   // A, AAAA, CNAME, MX, TXT, NS, SRV, CAA
  name        String
  value       String
  priority    Int      @default(0)
  ttl         Int      @default(3600)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([domain])
  @@index([type])
}

model SSLCertificate {
  id          String   @id @default(cuid())
  domain      String
  type        String   @default("dv")  // dv, ov, ev, wildcard
  issuer      String   @default("Let's Encrypt")
  validFrom   DateTime
  validTo     DateTime
  autoRenew   Boolean  @default(true)
  status      String   @default("active")  // active, expired, pending, revoked
  createdAt   DateTime @default(now())
  @@index([domain])
  @@index([status])
}

model Backup {
  id          String   @id @default(cuid())
  type        String   @default("full")  // full, database, files, image
  size        Int      @default(0)  // bytes
  path        String
  status      String   @default("completed")  // queued, running, completed, failed
  source      String   @default("manual")  // manual, scheduled
  notes       String   @default("")
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([status])
}

model EmailAccount {
  id          String   @id @default(cuid())
  email       String   @unique
  domain      String
  password    String
  quota       Int      @default(1024)  // MB
  usedQuota   Int      @default(0)
  forwardTo   String?
  autoReply   String?
  status      String   @default("active")
  lastAccess  DateTime?
  createdAt   DateTime @default(now())
  @@index([domain])
}

model FTPAccount {
  id          String   @id @default(cuid())
  username    String
  password    String
  path        String   @default("/")
  quota       Int      @default(0)  // 0 = unlimited, MB
  usedQuota   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
}

model NewsletterCampaign {
  id          String   @id @default(cuid())
  name        String
  subjectId   String
  subjectEn   String
  contentId   String
  contentEn   String
  // JSON: { sent, delivered, opened, clicked, bounced, unsubscribed }
  stats       String   @default("{}")
  status      String   @default("draft")  // draft, scheduled, sending, sent, paused
  scheduledAt DateTime?
  sentAt      DateTime?
  target      String   @default("all")  // all, active, segment
  targetCount Int      @default(0)
  createdBy   String   @default("admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   @default("percent")  // percent, fixed
  value       Float    @default(0)
  minOrder    Int      @default(0)
  maxDiscount Int      @default(0)
  usageLimit  Int      @default(0)  // 0 = unlimited
  used        Int      @default(0)
  validFrom   DateTime?
  validTo     DateTime?
  status      String   @default("active")  // active, expired, disabled
  appliesTo   String   @default("all")  // all, hosting, vps, domain, package:slug
  createdAt   DateTime @default(now())
  @@index([status])
}

model SecurityLog {
  id          String   @id @default(cuid())
  type        String   // login_success, login_failed, 2fa_enabled, 2fa_disabled, password_changed, ip_blocked, ip_whitelisted, suspicious_activity
  userId      String?
  username    String?
  ip          String?
  userAgent   String?
  location    String?
  details     String   @default("")
  severity    String   @default("info")  // info, warning, critical
  createdAt   DateTime @default(now())
  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

model StagingEnv {
  id          String   @id @default(cuid())
  name        String
  domain      String
  sourceDomain String
  branch      String   @default("main")
  status      String   @default("idle")  // idle, deploying, running, error
  deployUrl   String
  lastDeploy  DateTime?
  autoSync    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIWebsiteProject {
  id          String   @id @default(cuid())
  name        String
  business    String
  industry    String
  template    String   @default("modern")
  pages       String   @default("[]")  // JSON: list of generated pages
  status      String   @default("draft")  // draft, generating, completed, published
  publishedUrl String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitorStat {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD
  visitors    Int      @default(0)
  pageViews   Int      @default(0)
  uniqueIPs   Int      @default(0)
  bounceRate  Float    @default(0)
  avgTime     Int      @default(0)  // seconds
  topReferrer String?
  topCountry  String?
  topDevice   String?
  createdAt   DateTime @default(now())
  @@index([date])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // new_order, new_ticket, new_message, low_stock, ssl_expiring, backup_done, system
  title       String
  message     String
  icon        String   @default("Bell")
  read        Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([read])
}

// Domain TLD pricing (untuk halaman domain search)
model DomainTld {
  id          String   @id @default(cuid())
  tld         String   @unique // .com, .id, .web.id, .co.id, .net, .org, .info, .biz, .xyz, .online, .store, .tech, .site, .online
  register    Int      @default(0)   // harga register (IDR) /tahun
  transfer    Int      @default(0)
  renew       Int      @default(0)
  popular     Boolean  @default(false)
  promo       Boolean  @default(false)
  promoPrice  Int      @default(0)
  category    String   @default("popular") // popular, geo, business, tech, sale
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Layanan hosting aktif pelanggan (terlink ke Order)
model CustomerService {
  id            String   @id @default(cuid())
  customerId    String
  orderId       String?
  packageId     String?
  domain        String?   // domain terkait
  name          String    // nama layanan
  category      String    // hosting, vps, cloud, domain, ssl, email, wordpress
  billingCycle  String   @default("monthly")
  price         Int      @default(0)
  status        String   @default("active") // active, suspended, pending, cancelled, expired
  createdAt     DateTime @default(now())
  expiresAt     DateTime?
  username      String?
  serverName    String?
  @@index([customerId])
  @@index([status])
}

// Kompetitor / provider hosting & domain referensi (top 10+ dunia & Indonesia)
model Competitor {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  url           String
  logo          String?  // emoji atau inisial
  country       String   @default("Global") // Global, Indonesia, USA, dll
  region        String   @default("global") // global, indonesia
  type          String   @default("both") // hosting, domain, both
  founded       Int?     // tahun berdiri
  customers     String?  // jumlah pelanggan (human-readable, mis. "84M domains")
  marketShare   String?  // mis. "10.8%"
  description   String
  pros          String   @default("[]") // JSON array of string
  cons          String   @default("[]") // JSON array of string
  features      String   @default("[]") // JSON array
  pricingFrom   String?  // mis. "Rp 14.900/bln" atau "$2.99/mo"
  uptime        String?  // mis. "99.99%"
  datacenters   String?  // mis. "150+ negara"
  rating        Float    @default(4.5) // 0-5
  popular       Boolean  @default(false)
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
